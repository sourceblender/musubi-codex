{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-session-start",
            "timeout": 7
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-user-prompt-submit",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-interrupt",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
