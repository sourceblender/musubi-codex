{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-session-start",
            "timeout": 7
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
