{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*musubi.*__musubi_(recent|search|get|remember|status)$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "musubi-codex",
            "tool": "musubi_bind_context",
            "input": {
              "cwd": "${cwd}",
              "session_id": "${session_id}"
            },
            "timeout": 5,
            "statusMessage": "Binding Musubi project context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-session-start",
            "timeout": 7
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-stop --drain-only",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-user-prompt-submit",
            "timeout": 6,
            "additionalContextLimit": 1200
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "musubi-codex",
            "tool": "musubi_bind_context",
            "input": {
              "cwd": "${cwd}",
              "session_id": "${session_id}"
            },
            "timeout": 5,
            "statusMessage": "Binding Musubi project context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-stop",
            "timeout": 60
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "musubi-codex-interrupt",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
